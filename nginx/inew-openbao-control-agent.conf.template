server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{PUBLIC_HOST}};

    ssl_certificate {{TLS_CERTIFICATE_PATH}};
    ssl_certificate_key {{TLS_PRIVATE_KEY_PATH}};
    ssl_client_certificate {{DEVICE_CA_CERTIFICATE_PATH}};
    ssl_verify_client optional;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:{{AGENT_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-INew-Client-Cert $ssl_client_escaped_cert;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}

